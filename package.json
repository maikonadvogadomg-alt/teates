{
  "name": "testes",
  "version": "1.1.0",
  "description": "testes",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "portaDoPrograma": 8172,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikonadvogadomgalt.teste.app.pc.ntestes",
    "productName": "testes (testes)",
    "executableName": "testes-ntestes",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "**/*",
      "!android/**",
      "!.github/**",
      "!release/**",
      "!node_modules/.cache/**",
      "!*.zip",
      "!.sk/**",
      "!apk.config.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "testes (testes)",
      "artifactName": "testes-ntestes-Instalar.exe"
    },
    "portable": {
      "artifactName": "testes-ntestes-sem-instalar.exe"
    }
  }
}
